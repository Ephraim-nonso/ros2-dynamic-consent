# Gate -> Manager: is consent currently valid for (session, capability)?
# allowed is true only when status == STATUS_GRANTED.
string session_id
string capability_id
---
uint8 STATUS_UNKNOWN=0
uint8 STATUS_PENDING=1
uint8 STATUS_GRANTED=2
uint8 STATUS_REFUSED=3
uint8 STATUS_REVOKED=4
uint8 STATUS_EXPIRED=5

bool allowed
uint8 status
string reason
builtin_interfaces/Time expires_at
