<?xml version="1.0"?>
<sdf version="1.9">
  <world name="dynamic_consent_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- A logical camera avoids GPU rendering in OpenGL-limited UTM guests. -->
    <plugin filename="gz-sim-logical-camera-system" name="gz::sim::systems::LogicalCamera"/>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="Assistance study view">
        <gz-gui>
          <title>Assistance study view</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <scene>scene</scene>
        <ambient_light>0.7 0.7 0.7</ambient_light>
        <background_color>0.12 0.15 0.20</background_color>
        <camera_pose>-6.5 -6.5 6.5 0 0.55 0.78</camera_pose>
        <camera_clip><near>0.1</near><far>100</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="string" key="state">floating</property>
          <anchors target="Assistance study view">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause><step>true</step>
        <start_paused>false</start_paused>
        <service>/world/dynamic_consent_world/control</service>
        <stats_topic>/world/dynamic_consent_world/stats</stats_topic>
      </plugin>
      <plugin filename="EntityTree" name="Study entities"/>
    </gui>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.12 0.15 0.20 1</background>
    </scene>
    <light name="ceiling_light" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.25 0.15 -1</direction>
    </light>

    <model name="building_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry><box><size>12 7 0.1</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>12 7 0.1</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static><pose>0 3.45 1 0 0 0</pose>
      <link name="wall"><collision name="collision"><geometry><box><size>12 0.1 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 0.1 2</size></box></geometry><material><ambient>0.25 0.31 0.38 1</ambient><diffuse>0.25 0.31 0.38 1</diffuse></material></visual></link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>0 -3.45 1 0 0 0</pose>
      <link name="wall"><collision name="collision"><geometry><box><size>12 0.1 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 0.1 2</size></box></geometry><material><ambient>0.25 0.31 0.38 1</ambient><diffuse>0.25 0.31 0.38 1</diffuse></material></visual></link>
    </model>
    <model name="west_wall">
      <static>true</static><pose>-5.95 0 1 0 0 0</pose>
      <link name="wall"><collision name="collision"><geometry><box><size>0.1 7 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 7 2</size></box></geometry><material><ambient>0.25 0.31 0.38 1</ambient><diffuse>0.25 0.31 0.38 1</diffuse></material></visual></link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>5.95 0 1 0 0 0</pose>
      <link name="wall"><collision name="collision"><geometry><box><size>0.1 7 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 7 2</size></box></geometry><material><ambient>0.25 0.31 0.38 1</ambient><diffuse>0.25 0.31 0.38 1</diffuse></material></visual></link>
    </model>

    <!-- The robot stops west of this line when private-space access is refused. -->
    <model name="privacy_boundary">
      <static>true</static><pose>-1.65 0 0.065 0 0 0</pose>
      <link name="boundary_link">
        <visual name="boundary_visual">
          <geometry><box><size>0.08 5.8 0.025</size></box></geometry>
          <material><ambient>0.85 0.05 0.05 1</ambient><diffuse>0.85 0.05 0.05 1</diffuse><emissive>0.3 0 0 1</emissive></material>
        </visual>
      </link>
    </model>
    <model name="restricted_private_area">
      <static>true</static><pose>2.125 0 0.061 0 0 0</pose>
      <link name="area_link"><visual name="area_visual"><geometry><box><size>7.55 5.8 0.012</size></box></geometry><material><ambient>0.30 0.08 0.08 1</ambient><diffuse>0.30 0.08 0.08 1</diffuse></material></visual></link>
    </model>

    <!-- A stylised visitor makes the assistance relationship explicit. -->
    <model name="visitor_requesting_assistance">
      <static>true</static><pose>-3.05 0.75 0.05 0 0 0</pose>
      <link name="visitor">
        <visual name="left_leg"><pose>0 0.10 0.23 0 0 0</pose><geometry><box><size>0.12 0.12 0.46</size></box></geometry><material><ambient>0.12 0.16 0.28 1</ambient><diffuse>0.12 0.16 0.28 1</diffuse></material></visual>
        <visual name="right_leg"><pose>0 -0.10 0.23 0 0 0</pose><geometry><box><size>0.12 0.12 0.46</size></box></geometry><material><ambient>0.12 0.16 0.28 1</ambient><diffuse>0.12 0.16 0.28 1</diffuse></material></visual>
        <visual name="torso"><pose>0 0 0.90 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.90</length></cylinder></geometry><material><ambient>0.12 0.55 0.82 1</ambient><diffuse>0.12 0.55 0.82 1</diffuse></material></visual>
        <visual name="head"><pose>0 0 1.52 0 0 0</pose><geometry><sphere><radius>0.20</radius></sphere></geometry><material><ambient>0.64 0.42 0.30 1</ambient><diffuse>0.64 0.42 0.30 1</diffuse></material></visual>
        <visual name="pointing_arm"><pose>0.28 -0.28 1.12 0 0 -0.55</pose><geometry><box><size>0.70 0.10 0.10</size></box></geometry><material><ambient>0.64 0.42 0.30 1</ambient><diffuse>0.64 0.42 0.30 1</diffuse></material></visual>
      </link>
    </model>

    <model name="reception_start_point">
      <static>true</static><pose>-4.85 -1.45 0.05 0 0 0</pose>
      <link name="desk">
        <collision name="collision"><pose>0 0 0.45 0 0 0</pose><geometry><box><size>1.0 0.55 0.9</size></box></geometry></collision>
        <visual name="desk_visual"><pose>0 0 0.45 0 0 0</pose><geometry><box><size>1.0 0.55 0.9</size></box></geometry><material><ambient>0.18 0.32 0.48 1</ambient><diffuse>0.18 0.32 0.48 1</diffuse></material></visual>
        <visual name="reception_beacon"><pose>0 0 1.05 0 0 0</pose><geometry><sphere><radius>0.16</radius></sphere></geometry><material><ambient>0.12 0.55 0.95 1</ambient><diffuse>0.12 0.55 0.95 1</diffuse><emissive>0.05 0.2 0.35 1</emissive></material></visual>
      </link>
    </model>

    <!-- The red region is now a room with a wide doorway at the boundary. -->
    <model name="private_room_entrance">
      <static>true</static><pose>-1.65 0 0.05 0 0 0</pose>
      <link name="doorway">
        <collision name="north_partition_collision"><pose>0 2.05 0.9 0 0 0</pose><geometry><box><size>0.14 2.5 1.8</size></box></geometry></collision>
        <collision name="south_partition_collision"><pose>0 -2.05 0.9 0 0 0</pose><geometry><box><size>0.14 2.5 1.8</size></box></geometry></collision>
        <visual name="north_partition"><pose>0 2.05 0.9 0 0 0</pose><geometry><box><size>0.14 2.5 1.8</size></box></geometry><material><ambient>0.45 0.18 0.18 1</ambient><diffuse>0.45 0.18 0.18 1</diffuse></material></visual>
        <visual name="south_partition"><pose>0 -2.05 0.9 0 0 0</pose><geometry><box><size>0.14 2.5 1.8</size></box></geometry><material><ambient>0.45 0.18 0.18 1</ambient><diffuse>0.45 0.18 0.18 1</diffuse></material></visual>
        <visual name="door_lintel"><pose>0 0 1.7 0 0 0</pose><geometry><box><size>0.18 1.6 0.22</size></box></geometry><material><ambient>0.88 0.16 0.10 1</ambient><diffuse>0.88 0.16 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <model name="assistance_destination">
      <static>true</static><pose>-0.70 0 0.05 0 0 0</pose>
      <link name="destination_arch">
        <visual name="left_post"><pose>0 0.75 0.8 0 0 0</pose><geometry><box><size>0.18 0.18 1.6</size></box></geometry><material><ambient>0.10 0.72 0.32 1</ambient><diffuse>0.10 0.72 0.32 1</diffuse></material></visual>
        <visual name="right_post"><pose>0 -0.75 0.8 0 0 0</pose><geometry><box><size>0.18 0.18 1.6</size></box></geometry><material><ambient>0.10 0.72 0.32 1</ambient><diffuse>0.10 0.72 0.32 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 1.55 0 0 0</pose><geometry><box><size>0.18 1.68 0.18</size></box></geometry><material><ambient>0.10 0.72 0.32 1</ambient><diffuse>0.10 0.72 0.32 1</diffuse><emissive>0.03 0.22 0.08 1</emissive></material></visual>
      </link>
    </model>

    <model name="authorised_staff_assistance_station">
      <static>true</static><pose>-0.55 2.45 0.05 0 0 0</pose>
      <link name="station">
        <visual name="stand"><pose>0 0 0.55 0 0 0</pose><geometry><box><size>0.55 0.35 1.1</size></box></geometry><material><ambient>0.28 0.18 0.45 1</ambient><diffuse>0.28 0.18 0.45 1</diffuse></material></visual>
        <visual name="screen"><pose>-0.02 -0.19 1.05 1.5708 0 0</pose><geometry><box><size>0.45 0.04 0.34</size></box></geometry><material><ambient>0.65 0.23 0.78 1</ambient><diffuse>0.65 0.23 0.78 1</diffuse><emissive>0.20 0.06 0.28 1</emissive></material></visual>
      </link>
    </model>

    <!-- A fixed colour key matches the terminal study dashboard. -->
    <model name="status_indicator_legend">
      <static>true</static><pose>-4.7 -2.55 0.05 0 0 0</pose>
      <link name="legend">
        <visual name="ready_blue"><pose>0 0 0.18 0 0 0</pose><geometry><box><size>0.22 0.22 0.36</size></box></geometry><material><ambient>0.12 0.55 0.95 1</ambient><diffuse>0.12 0.55 0.95 1</diffuse></material></visual>
        <visual name="waiting_yellow"><pose>0.30 0 0.18 0 0 0</pose><geometry><box><size>0.22 0.22 0.36</size></box></geometry><material><ambient>0.92 0.78 0.12 1</ambient><diffuse>0.92 0.78 0.12 1</diffuse></material></visual>
        <visual name="granted_green"><pose>0.60 0 0.18 0 0 0</pose><geometry><box><size>0.22 0.22 0.36</size></box></geometry><material><ambient>0.10 0.72 0.32 1</ambient><diffuse>0.10 0.72 0.32 1</diffuse></material></visual>
        <visual name="fallback_orange"><pose>0.90 0 0.18 0 0 0</pose><geometry><box><size>0.22 0.22 0.36</size></box></geometry><material><ambient>0.95 0.45 0.08 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Seven coloured pads make the deterministic study stages visible. -->
    <model name="stage_1_person_recognition"><static>true</static><pose>-3.6 2.7 0.08 0 0 0</pose><link name="pad"><visual name="visual"><geometry><box><size>0.25 0.45 0.04</size></box></geometry><material><ambient>0.12 0.55 0.95 1</ambient><diffuse>0.12 0.55 0.95 1</diffuse></material></visual></link></model>
    <model name="stage_2_speech_input"><static>true</static><pose>-3.2 2.7 0.08 0 0 0</pose><link name="pad"><visual name="visual"><geometry><box><size>0.25 0.45 0.04</size></box></geometry><material><ambient>0.14 0.68 0.75 1</ambient><diffuse>0.14 0.68 0.75 1</diffuse></material></visual></link></model>
    <model name="stage_3_interaction_memory"><static>true</static><pose>-2.8 2.7 0.08 0 0 0</pose><link name="pad"><visual name="visual"><geometry><box><size>0.25 0.45 0.04</size></box></geometry><material><ambient>0.20 0.74 0.50 1</ambient><diffuse>0.20 0.74 0.50 1</diffuse></material></visual></link></model>
    <model name="stage_4_body_pose_tracking"><static>true</static><pose>-2.4 2.7 0.08 0 0 0</pose><link name="pad"><visual name="visual"><geometry><box><size>0.25 0.45 0.04</size></box></geometry><material><ambient>0.72 0.72 0.15 1</ambient><diffuse>0.72 0.72 0.15 1</diffuse></material></visual></link></model>
    <model name="stage_5_route_guidance"><static>true</static><pose>-2.0 2.7 0.08 0 0 0</pose><link name="pad"><visual name="visual"><geometry><box><size>0.25 0.45 0.04</size></box></geometry><material><ambient>0.95 0.52 0.08 1</ambient><diffuse>0.95 0.52 0.08 1</diffuse></material></visual></link></model>
    <model name="stage_6_proximity_or_private_space_access"><static>true</static><pose>-1.6 2.7 0.08 0 0 0</pose><link name="pad"><visual name="visual"><geometry><box><size>0.25 0.45 0.04</size></box></geometry><material><ambient>0.92 0.18 0.12 1</ambient><diffuse>0.92 0.18 0.12 1</diffuse></material></visual></link></model>
    <model name="stage_7_remote_assistance_stream"><static>true</static><pose>-1.2 2.7 0.08 0 0 0</pose><link name="pad"><visual name="visual"><geometry><box><size>0.25 0.45 0.04</size></box></geometry><material><ambient>0.65 0.23 0.78 1</ambient><diffuse>0.65 0.23 0.78 1</diffuse></material></visual></link></model>

    <model name="consent_robot">
      <pose>-4.0 0 0.23 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>6.0</mass><inertia><ixx>0.18</ixx><iyy>0.28</iyy><izz>0.35</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="base_collision"><geometry><box><size>0.55 0.42 0.22</size></box></geometry></collision>
        <visual name="base_visual"><geometry><box><size>0.55 0.42 0.22</size></box></geometry><material><ambient>0.05 0.35 0.78 1</ambient><diffuse>0.05 0.35 0.78 1</diffuse></material></visual>
        <visual name="consent_indicator"><pose>0 0 0.20 0 0 0</pose><geometry><sphere><radius>0.09</radius></sphere></geometry><material><ambient>0.10 0.90 0.55 1</ambient><diffuse>0.10 0.90 0.55 1</diffuse><emissive>0.03 0.25 0.10 1</emissive></material></visual>
      </link>
      <!-- Humanoid upper body mounted on a stable differential-drive base. -->
      <link name="torso_link">
        <pose relative_to="base_link">0 0 0.58 0 0 0</pose>
        <inertial><mass>1.0</mass><inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.03</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="torso_visual"><geometry><box><size>0.34 0.28 0.72</size></box></geometry><material><ambient>0.08 0.42 0.82 1</ambient><diffuse>0.08 0.42 0.82 1</diffuse></material></visual>
        <visual name="left_arm"><pose>0 0.23 0 0 0 0</pose><geometry><capsule><radius>0.055</radius><length>0.52</length></capsule></geometry><material><ambient>0.72 0.76 0.82 1</ambient><diffuse>0.72 0.76 0.82 1</diffuse></material></visual>
        <visual name="right_arm"><pose>0 -0.23 0 0 0 0</pose><geometry><capsule><radius>0.055</radius><length>0.52</length></capsule></geometry><material><ambient>0.72 0.76 0.82 1</ambient><diffuse>0.72 0.76 0.82 1</diffuse></material></visual>
      </link>
      <link name="sensor_head">
        <pose relative_to="base_link">0 0 1.08 0 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.008</ixx><iyy>0.008</iyy><izz>0.008</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="head_visual"><geometry><sphere><radius>0.19</radius></sphere></geometry><material><ambient>0.75 0.80 0.88 1</ambient><diffuse>0.75 0.80 0.88 1</diffuse></material></visual>
        <visual name="camera_eye"><pose>0.18 0 0.03 0 0 0</pose><geometry><sphere><radius>0.045</radius></sphere></geometry><material><ambient>0.05 0.80 0.65 1</ambient><diffuse>0.05 0.80 0.65 1</diffuse><emissive>0.02 0.25 0.18 1</emissive></material></visual>
        <sensor name="privacy_logical_camera" type="logical_camera">
          <pose>0.18 0 0.03 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <visualize>false</visualize>
          <topic>/sensors/logical_camera/raw</topic>
          <logical_camera>
            <near>0.20</near>
            <far>4.0</far>
            <horizontal_fov>1.60</horizontal_fov>
            <aspect_ratio>1.50</aspect_ratio>
          </logical_camera>
        </sensor>
      </link>
      <link name="left_wheel">
        <pose relative_to="base_link">0 0.24 -0.08 1.5708 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      </link>
      <link name="right_wheel">
        <pose relative_to="base_link">0 -0.24 -0.08 1.5708 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.1</radius><length>0.06</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
      </link>
      <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="torso_joint" type="fixed"><parent>base_link</parent><child>torso_link</child></joint>
      <joint name="head_joint" type="fixed"><parent>base_link</parent><child>sensor_head</child></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.48</wheel_separation>
        <wheel_radius>0.10</wheel_radius>
        <topic>/model/consent_robot/cmd_vel</topic>
        <odom_topic>/model/consent_robot/odometry</odom_topic>
      </plugin>
    </model>
  </world>
</sdf>
