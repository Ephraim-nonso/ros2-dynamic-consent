<?xml version="1.0"?>
<sdf version="1.9">
  <world name="camera_consent_avatar_world">
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="Camera consent avatar">
        <gz-gui>
          <title>Consent-controlled expression avatar</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre</engine>
        <scene>scene</scene>
        <ambient_light>0.55 0.55 0.55</ambient_light>
        <background_color>0.06 0.08 0.12</background_color>
        <camera_pose>4.2 -4.2 2.5 0 0.12 2.34</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="EntityTree" name="Avatar entities"/>
    </gui>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.06 0.08 0.12 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="key_light" type="directional">
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="studio_floor">
      <static>true</static>
      <link name="floor">
        <collision name="collision">
          <geometry><box><size>8 8 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 8 0.1</size></box></geometry>
          <material>
            <ambient>0.18 0.22 0.28 1</ambient>
            <diffuse>0.18 0.22 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="consent_avatar">
      <pose>0 0 0.05 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>8</mass>
          <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.48</radius><length>0.18</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.48</radius><length>0.18</length></cylinder></geometry>
          <material><ambient>0.05 0.25 0.58 1</ambient><diffuse>0.05 0.25 0.58 1</diffuse></material>
        </visual>
      </link>
      <joint name="world_fixed" type="fixed">
        <parent>world</parent><child>base_link</child>
      </joint>

      <link name="torso_link">
        <pose relative_to="base_link">0 0 0.75 0 0 0</pose>
        <inertial><mass>3</mass><inertia><ixx>0.2</ixx><iyy>0.2</iyy><izz>0.2</izz></inertia></inertial>
        <visual name="torso">
          <geometry><box><size>0.58 0.72 1.2</size></box></geometry>
          <material><ambient>0.08 0.44 0.82 1</ambient><diffuse>0.08 0.44 0.82 1</diffuse></material>
        </visual>
        <visual name="consent_badge">
          <pose>0.31 0 0.20 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.05 0.85 0.48 1</ambient><diffuse>0.05 0.85 0.48 1</diffuse><emissive>0.02 0.2 0.08 1</emissive></material>
        </visual>
      </link>
      <joint name="torso_fixed" type="fixed">
        <parent>base_link</parent><child>torso_link</child>
      </joint>

      <link name="left_arm_link">
        <pose relative_to="torso_link">0 0.48 0.03 0 0 0</pose>
        <inertial><mass>0.4</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
        <visual name="arm"><geometry><capsule><radius>0.09</radius><length>0.75</length></capsule></geometry><material><ambient>0.65 0.72 0.82 1</ambient><diffuse>0.65 0.72 0.82 1</diffuse></material></visual>
      </link>
      <joint name="left_arm_fixed" type="fixed"><parent>torso_link</parent><child>left_arm_link</child></joint>
      <link name="right_arm_link">
        <pose relative_to="torso_link">0 -0.48 0.03 0 0 0</pose>
        <inertial><mass>0.4</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
        <visual name="arm"><geometry><capsule><radius>0.09</radius><length>0.75</length></capsule></geometry><material><ambient>0.65 0.72 0.82 1</ambient><diffuse>0.65 0.72 0.82 1</diffuse></material></visual>
      </link>
      <joint name="right_arm_fixed" type="fixed"><parent>torso_link</parent><child>right_arm_link</child></joint>

      <link name="neck_yaw_link">
        <pose relative_to="torso_link">0 0 0.72 0 0 0</pose>
        <inertial><mass>0.2</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
        <visual name="neck"><geometry><cylinder><radius>0.11</radius><length>0.24</length></cylinder></geometry><material><ambient>0.65 0.72 0.82 1</ambient><diffuse>0.65 0.72 0.82 1</diffuse></material></visual>
      </link>
      <joint name="head_yaw_joint" type="revolute">
        <parent>torso_link</parent><child>neck_yaw_link</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-0.7</lower><upper>0.7</upper><effort>20</effort><velocity>2</velocity></limit></axis>
      </joint>

      <link name="head_link">
        <pose relative_to="neck_yaw_link">0 0 0.30 0 0 0</pose>
        <inertial><mass>1</mass><inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.04</izz></inertia></inertial>
        <visual name="head"><geometry><sphere><radius>0.34</radius></sphere></geometry><material><ambient>0.72 0.78 0.88 1</ambient><diffuse>0.72 0.78 0.88 1</diffuse></material></visual>
        <visual name="left_eye"><pose>0.29 0.12 0.07 0 0 0</pose><geometry><sphere><radius>0.07</radius></sphere></geometry><material><ambient>0.94 0.98 1 1</ambient><diffuse>0.94 0.98 1 1</diffuse></material></visual>
        <visual name="right_eye"><pose>0.29 -0.12 0.07 0 0 0</pose><geometry><sphere><radius>0.07</radius></sphere></geometry><material><ambient>0.94 0.98 1 1</ambient><diffuse>0.94 0.98 1 1</diffuse></material></visual>
        <visual name="left_pupil"><pose>0.354 0.12 0.07 0 0 0</pose><geometry><sphere><radius>0.028</radius></sphere></geometry><material><ambient>0.02 0.08 0.14 1</ambient><diffuse>0.02 0.08 0.14 1</diffuse></material></visual>
        <visual name="right_pupil"><pose>0.354 -0.12 0.07 0 0 0</pose><geometry><sphere><radius>0.028</radius></sphere></geometry><material><ambient>0.02 0.08 0.14 1</ambient><diffuse>0.02 0.08 0.14 1</diffuse></material></visual>
      </link>
      <joint name="head_roll_joint" type="revolute">
        <parent>neck_yaw_link</parent><child>head_link</child>
        <axis><xyz>1 0 0</xyz><limit><lower>-0.5</lower><upper>0.5</upper><effort>20</effort><velocity>2</velocity></limit></axis>
      </joint>

      <link name="eyelid_link">
        <pose relative_to="head_link">0.35 0 0.11 0 0 0</pose>
        <inertial><mass>0.02</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <visual name="left_lid"><pose>0 0.12 0 0 0 0</pose><geometry><box><size>0.025 0.13 0.035</size></box></geometry><material><ambient>0.12 0.42 0.72 1</ambient><diffuse>0.12 0.42 0.72 1</diffuse></material></visual>
        <visual name="right_lid"><pose>0 -0.12 0 0 0 0</pose><geometry><box><size>0.025 0.13 0.035</size></box></geometry><material><ambient>0.12 0.42 0.72 1</ambient><diffuse>0.12 0.42 0.72 1</diffuse></material></visual>
      </link>
      <joint name="eyelid_joint" type="prismatic">
        <parent>head_link</parent><child>eyelid_link</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-0.08</lower><upper>0</upper><effort>5</effort><velocity>1</velocity></limit></axis>
      </joint>

      <link name="jaw_link">
        <pose relative_to="head_link">0.29 0 -0.15 0 0 0</pose>
        <inertial><mass>0.08</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
        <visual name="mouth"><geometry><box><size>0.08 0.24 0.065</size></box></geometry><material><ambient>0.70 0.08 0.12 1</ambient><diffuse>0.70 0.08 0.12 1</diffuse></material></visual>
      </link>
      <joint name="jaw_joint" type="revolute">
        <parent>head_link</parent><child>jaw_link</child>
        <axis><xyz>0 1 0</xyz><limit><lower>0</lower><upper>0.42</upper><effort>5</effort><velocity>2</velocity></limit></axis>
      </joint>

      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>head_yaw_joint</joint_name><topic>/avatar/head_yaw</topic><p_gain>8</p_gain>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>head_roll_joint</joint_name><topic>/avatar/head_roll</topic><p_gain>8</p_gain>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>eyelid_joint</joint_name><topic>/avatar/eyelid</topic><p_gain>12</p_gain>
      </plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>jaw_joint</joint_name><topic>/avatar/jaw</topic><p_gain>10</p_gain>
      </plugin>
    </model>
  </world>
</sdf>
